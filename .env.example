# Copy to .env (git-ignored). Everything is optional: scores replay offline from the
# committed caches. Live memo calls use these command-line tools:
CODEX_CLI_BIN=codex
CLAUDE_CLI_BIN=claude
# Calls run with a minimal environment. A launcher in CLAUDE_CLI_BIN that needs more
# variables lists their names here, comma-separated (values are read from the shell).
CLAUDE_CLI_ENV=
